# PostgreSQL
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=cambia-esto
DB_PASSWORD=cambia-esto

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=

# Admin inicial
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# IA — análisis de documentos (OPCIONAL)
# Fallback a nivel servidor solo para OpenAI. Cada empresa puede configurar
# su propio proveedor (OpenAI, OpenRouter, Groq, Ollama o URL personalizada)
# con su propia API key desde la pestaña Configuración de la web.
OPENAI_API_KEY=

# Resend (alertas de email)
RESEND_API_KEY=
ALERTA_FROM=flota@empresa.com
ALERTA_TO=pagos@empresa.com

# Lookup de patentes (opcional, AutoRiesgo es gratis)
BOOSTR_API_KEY=
